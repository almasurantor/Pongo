\set user_index :client_id + 1
\set action random(1,2)
BEGIN;
SET LOCAL ROLE authenticated;
SELECT set_config(
  'request.jwt.claim.sub',
  ('f9000000-0000-4000-8000-'||lpad((:user_index)::text,12,'0')),
  TRUE
);
\if :action = 1
  SELECT public.beaver_queue_join_v1();
\else
  SELECT public.beaver_queue_leave_v1();
\endif
COMMIT;
